# Replace all /path/to/mcp-local-gateway with the absolute path where you cloned the repo.
# Replace "youruser" and "yourgroup" (e.g. www-data) with the user/group that will run the gateway.

[Unit]
Description=MCP Local Gateway (Gunicorn)
After=network.target redis-server.service

[Service]
User=youruser
Group=www-data
WorkingDirectory=/path/to/mcp-local-gateway
EnvironmentFile=/path/to/mcp-local-gateway/.env
Environment="PATH=/path/to/mcp-local-gateway/venv/bin"
Environment="TESTING=0"
ExecStart=/path/to/mcp-local-gateway/venv/bin/gunicorn \
    --workers 3 \
    --umask 007 \
    --bind unix:/path/to/mcp-local-gateway/gateway.sock \
    --access-logfile /path/to/mcp-local-gateway/access.log \
    --error-logfile /path/to/mcp-local-gateway/error.log \
    app:app
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
