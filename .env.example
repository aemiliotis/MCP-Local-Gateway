# Paths (defaults to ./api.db and ./gateway.db next to app.py)
API_DB=./api.db
GATEWAY_DB=./gateway.db

# Gateway tuning
TRUST_THRESHOLD=C
DEFAULT_SESSION_CAP=5.00
COST_PER_1K_TOKENS=0.002
TOKENS_PER_ARG_BYTE=0.25

# Optional: trust API
MCP_TRUST_API=http://127.0.0.1:8000

# Rate limiter
REDIS_URL=redis://localhost:6379/0

# MCP servers (JSON object: slug -> base URL)
MCP_SERVERS_JSON={"weather":"http://127.0.0.1:9001","database":"http://127.0.0.1:9002"}

# API keys (JSON object: sha256(raw_key) -> tenant)
# Generate with: python scripts/generate_api_key.py
API_KEYS_JSON={"<sha256-of-your-key>":"tenant-1"}
